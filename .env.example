# Copy this file to sales_portal.api/.env and adjust values for your machine.
# Never commit .env (it is git-ignored).
#
# PostgreSQL connection string. Replace the sample values with your own database.
DB_CONNECTION_STRING="Server=localhost;Port=5433;Database=sales_portal;User Id=sales_portal;Password=sales_portal_dev;Ssl Mode=Disable;"

# Direct PostgreSQL connection for LISTEN/NOTIFY live updates. Required when DB_CONNECTION_STRING
# goes through a transaction pooler (pgbouncer/Supabase pooler), because LISTEN needs a direct
# session connection. Falls back to DB_CONNECTION_STRING / ConnectionStrings:Default when unset.
# PORTAL_NOTIFICATIONS_CONNECTION_STRING="Server=localhost;Port=5433;Database=sales_portal;User Id=sales_portal;Password=sales_portal_dev;Ssl Mode=Disable;"

# Optional dedicated LISTEN connection for live updates. LISTEN needs a direct (non-transaction-pooled)
# PostgreSQL connection; without this it falls back to ConnectionStrings:Default / DB_CONNECTION_STRING.
# PORTAL_NOTIFICATIONS_CONNECTION_STRING="Server=localhost;Port=5433;Database=sales_portal;User Id=sales_portal;Password=sales_portal_dev;Ssl Mode=Disable;"

# Required. Must be at least 32 characters. Startup fails when it is missing or too short.
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
JWT_ISSUER="SalesPortalAPI"
JWT_AUDIENCE="SalesPortalClient"

ERPNEXT_URL=""

# First-admin bootstrap (Production only). Remove after first login.
# BOOTSTRAP_ADMIN_USERNAME="admin"
# BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123456"
# BOOTSTRAP_ADMIN_FULL_NAME="Admin User"
# BOOTSTRAP_ADMIN_INITIALS="AU"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
