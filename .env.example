# Copy this file to sales_portal.api/.env and adjust values for your machine.
# Never commit .env (it is git-ignored).
#
# Local development database:
#   docker compose up -d
#   (PostgreSQL 16 on localhost:5433, database/user/password: sales_portal)
DB_CONNECTION_STRING="Server=localhost;Port=5433;Database=sales_portal;User Id=sales_portal;Password=sales_portal_dev;Ssl Mode=Disable;"

# Required. Must be at least 32 characters. Startup fails when it is missing or too short.
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
JWT_ISSUER="SalesPortalAPI"
JWT_AUDIENCE="SalesPortalClient"

ERPNEXT_URL=""
